# Valores APENAS para desenvolvimento local. Copie para .env:  cp .env.example .env
# O .env é lido pelo Docker Compose e também pelo backend (./mvnw spring-boot:run).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=people
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT (HMAC-SHA256: mínimo de 32 caracteres). Em produção gere com: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRATION=PT1H

# Usuário administrador criado no primeiro start (senha persistida como hash BCrypt)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Integração externa
NATIONALIZE_BASE_URL=https://api.nationalize.io
NATIONALIZE_TIMEOUT=PT5S

# Swagger UI / OpenAPI (desabilite em produção se desejar)
SWAGGER_ENABLED=true

# Frontend: URL do backend vista pelo navegador
VITE_API_URL=http://localhost:8080
